# Contact form lead delivery (see README "Wire up lead delivery").
# Leave unset during development — the form still works end to end and
# falls back to a mailto: link on-screen. Set this before real launch.
FORMSPREE_ENDPOINT=

# Show placeholder testimonials / client logos in a production build.
# Leave unset (or "false") until real, permissioned proof lands in site.ts —
# placeholders always render in development regardless of this value.
NEXT_PUBLIC_SHOW_PLACEHOLDER_PROOF=
